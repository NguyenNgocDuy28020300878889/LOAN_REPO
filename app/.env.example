# Expo public configuration. Do not commit a populated .env file.
EXPO_PUBLIC_APP_ENV=development
# Set true only after hosted SMTP, code template, and delivery are verified.
EXPO_PUBLIC_EMAIL_OTP_READY=false
# Non-public build attestation required when hosted email OTP is enabled.
EMAIL_OTP_SMTP_VERIFIED=false
# Enable after Google provider and exact callback URLs are configured for this environment.
EXPO_PUBLIC_GOOGLE_AUTH_READY=false
# Enable only after FCM, server migrations, worker and cron are verified in this environment.
EXPO_PUBLIC_PUSH_READY=false
# Exact public HTTPS origin used for production invitation App Links (no path or trailing content).
EXPO_PUBLIC_APP_LINK_ORIGIN=
# Used only by `npm run generate:assetlinks`; comma-separate EAS/Play signing SHA-256 fingerprints.
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=
# EAS file variable containing the Android Firebase client configuration (not a service account).
GOOGLE_SERVICES_JSON=
# Required in each EAS preview/production environment. Public project ID, not a key.
EXPO_EXPECTED_SUPABASE_PROJECT_REF=
EXPO_PUBLIC_SUPABASE_DEVELOPMENT_URL=
EXPO_PUBLIC_SUPABASE_DEVELOPMENT_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_STAGING_URL=
EXPO_PUBLIC_SUPABASE_STAGING_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_PRODUCTION_URL=
EXPO_PUBLIC_SUPABASE_PRODUCTION_PUBLISHABLE_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# Source-map upload credentials stay in CI secrets; never expose them with EXPO_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
